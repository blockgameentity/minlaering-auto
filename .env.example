# Used to generate the text for free-text (essay) tasks.
# Get a key from https://neuralwatt.com and paste it here, or export it in your shell.
NEURALWATT_API_KEY=

# Optional overrides. The defaults below are what the CLI uses when these are
# unset, so this file only needs NEURALWATT_API_KEY to work.
# MINLAERING_LLM_BASE_URL=https://api.neuralwatt.com/v1
# MINLAERING_LLM_MODEL=mimo-v2.6-pro
# MINLAERING_LLM_TEMPERATURE=0.8

# Any other OpenAI-compatible endpoint works too, e.g. a local Ollama:
# MINLAERING_LLM_BASE_URL=http://localhost:11434/v1
# MINLAERING_LLM_MODEL=llama3
